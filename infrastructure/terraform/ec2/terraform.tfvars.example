expected_account_id = "replace-with-verified-account-id"
deployment_id = "replace-with-deployment-id"
monitoring_interviewer_email = "reviewer@example.com"
reviewer_ssh_cidr = "replace-with-reviewer-ipv4-cidr"
reviewed_ami_id = "replace-with-reviewed-al2023-x86-64-ami-id"
postgres_version = "replace-with-compatible-major.minor-version"
# Optional existing reviewer key pair; SSM is the primary access method.
ssh_key_name = null
# Null creates a private artifact bucket and application secret metadata.
# Secret population and artifact upload require separate approval after apply.
artifact_bucket = null
app_secret_arn = null
# Fresh deployment: true generates the application DB credential during apply
# (write-only, never in state). Keep false if the secret is already populated.
manage_application_secret_value = true
# Opens port 22 to reviewer_ssh_cidr only. SSM Session Manager is the default access path.
enable_reviewer_ssh = false
