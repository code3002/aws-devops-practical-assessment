# Fixed start (e.g. repository access grant), UTC. Never recompute; extend with TTL_HOURS.
DEPLOYMENT_STARTED_AT = "replace-with-fixed-utc-start-time"
TTL_HOURS             = 48
# false = schedule DISABLED (cancelled). true = destroy fires at start + TTL_HOURS.
TEARDOWN_ENABLED = false
# DESTROY performs the ordered terraform destroy; PREFLIGHT_ONLY only plans it.
EXECUTION_MODE    = "PREFLIGHT_ONLY"
AWS_ACCOUNT_ID    = "replace-with-verified-account-id"
DEPLOYMENT_ID     = "replace-with-teardown-name"
EC2_DEPLOYMENT_ID = "replace-with-ec2-deployment-id"
EKS_CLUSTER_NAME  = "replace-with-eks-deployment-id-eks"
# Extra IAM name prefixes for adopted resources with legacy names.
EXTRA_IAM_NAME_PREFIXES = []
SOURCE_VERSION          = "refs/heads/main"
BACKEND_BUCKET          = "replace-with-existing-state-bucket"
LOCK_TABLE              = "replace-with-existing-lock-table"
