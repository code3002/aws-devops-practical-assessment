expected_account_id = "replace-with-verified-account-id"
state_bucket        = "replace-with-existing-state-bucket"
# Image tag pushed by CodeBuild (<commit-sha> or latest).
python_image_tag         = "latest"
# false on an AWS Free account plan (t3.medium launches are rejected there).
python_time_on_karpenter = true
eks_record_name          = "eks"
# true only when adopting objects created outside Terraform.
adopt_existing_resources = false
